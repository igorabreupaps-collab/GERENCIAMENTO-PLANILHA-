# Copie este arquivo para ".env" (nunca commite o .env de verdade) antes de
# rodar "docker compose up".

# --- PostgreSQL ---
POSTGRES_USER=spda
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=painel_spda

# --- API ---
# Gere um valor aleatório longo, por exemplo: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=7d
PORT=3000

# --- Primeiro usuário administrador (criado automaticamente na primeira
# subida do serviço "migrate" -- ver docker-compose.yml) ---
BOOTSTRAP_ADMIN_EMAIL=admin@suaempresa.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-tambem
BOOTSTRAP_ADMIN_NOME=Administrador
